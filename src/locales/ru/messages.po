#: locales/legacy-messages.ts
msgid ". Рост берётся у примитива, которого модель заменила, —"
msgstr ". Рост берётся у примитива, которого модель заменила, —"

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Рост читается ещё и так, без цифр."
msgstr ". Рост читается ещё и так, без цифр."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Своего рига клипы игры не двигают, ретаргета нет. Ответ — не терпеть, а перерисовать: оба собраны заново числами на общем риге, тем же способом, что поселенец и торговец."
msgstr ". Своего рига клипы игры не двигают, ретаргета нет. Ответ — не терпеть, а перерисовать: оба собраны заново числами на общем риге, тем же способом, что поселенец и торговец."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Семья дерева была вдвое темнее той, которой дерево рисуют оба набора KayKit, и светлая половина набора складывалась в тёмную половину палитры:"
msgstr ". Семья дерева была вдвое темнее той, которой дерево рисуют оба набора KayKit, и светлая половина набора складывалась в тёмную половину палитры:"

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Серебро и железо расходятся сами: они из одной холодной клетки, но серебро светлее — и уезжает в иней, ради которого у металла появилась четвёртая ступень. А вот"
msgstr ". Серебро и железо расходятся сами: они из одной холодной клетки, но серебро светлее — и уезжает в иней, ради которого у металла появилась четвёртая ступень. А вот"

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Сетка внизу — наши клетки, она едет со скоростью героя, 1,67 тайла в секунду."
msgstr ". Сетка внизу — наши клетки, она едет со скоростью героя, 1,67 тайла в секунду."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Синее — чертёж и жесть, алое — метки на картах и рукоятях: набор рисует рабочую утварь, а не витрину, и ярких пятен в нём ровно столько, сколько нужно, чтобы бумага не сливалась с верёвкой."
msgstr ". Синее — чертёж и жесть, алое — метки на картах и рукоятях: набор рисует рабочую утварь, а не витрину, и ярких пятен в нём ровно столько, сколько нужно, чтобы бумага не сливалась с верёвкой."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Синее сукно становится серым камнем, алое — коричневым деревом:"
msgstr ". Синее сукно становится серым камнем, алое — коричневым деревом:"

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Снятое возвращается в рюкзак, занятый слот меняется местами с тем, что несёшь."
msgstr ". Снятое возвращается в рюкзак, занятый слот меняется местами с тем, что несёшь."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Соседний документ того же ряда —"
msgstr ". Соседний документ того же ряда —"

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Состояние читается за полсекунды и означает вещь, за которой игрок пришёл, — идёт ли производство провианта."
msgstr ". Состояние читается за полсекунды и означает вещь, за которой игрок пришёл, — идёт ли производство провианта."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Список догнал состояние — ограда, настил и фонари переживают перезапуск, и это нашлось при вводе дорог, а не от жалобы."
msgstr ". Список догнал состояние — ограда, настил и фонари переживают перезапуск, и это нашлось при вводе дорог, а не от жалобы."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Строчка держалась на фигурах, которых не осталось: примитивных классов нет ни одного — у рыцаря, лучника и бандита с §6.1.4 стоят модели набора, — а свои модели в неё не укладывались никогда, поселенец и торговец идут по 2400–3100 (§6.1.10). Проверка в"
msgstr ". Строчка держалась на фигурах, которых не осталось: примитивных классов нет ни одного — у рыцаря, лучника и бандита с §6.1.4 стоят модели набора, — а свои модели в неё не укладывались никогда, поселенец и торговец идут по 2400–3100 (§6.1.10). Проверка в"

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Ступеней у дерева четыре, и набор занял две нижние: светлое дерево у него есть, но его"
msgstr ". Ступеней у дерева четыре, и набор занял две нижние: светлое дерево у него есть, но его"

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Таблица сравнивает пары одного рода из двух наборов — и"
msgstr ". Таблица сравнивает пары одного рода из двух наборов — и"

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Тайминги одинаковые, разница только в том, появляется ли на экране новый предмет."
msgstr ". Тайминги одинаковые, разница только в том, появляется ли на экране новый предмет."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Так закрыто пять имён из четырнадцати. Восемь — сигнальные: их тембр выведен из разнесения по частоте, и записанного фоли, которое сообщало бы то же, в наборе нет. Четырнадцатое, взмах, кандидата имело и всё равно осталось синтезом — по существу, а не по весу. Пятнадцатое, подарок за вход, пришло позже набора: кандидата ему не искали вовсе."
msgstr ". Так закрыто пять имён из четырнадцати. Восемь — сигнальные: их тембр выведен из разнесения по частоте, и записанного фоли, которое сообщало бы то же, в наборе нет. Четырнадцатое, взмах, кандидата имело и всё равно осталось синтезом — по существу, а не по весу. Пятнадцатое, подарок за вход, пришло позже набора: кандидата ему не искали вовсе."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Так провал остаётся ценой одной вылазки, а не откатом прогресса, — ровно как записано в §1."
msgstr ". Так провал остаётся ценой одной вылазки, а не откатом прогресса, — ровно как записано в §1."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Такая ступень не ошибка и не повод её убирать: она показывает, что набор до этого края шкалы почти не доходит, и перекрасить его можно, не трогая соседние."
msgstr ". Такая ступень не ошибка и не повод её убирать: она показывает, что набор до этого края шкалы почти не доходит, и перекрасить его можно, не трогая соседние."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Там, где клетки разошлись по тону, всё сходится само; там, где они сошлись, окно приходится ставить по замеру."
msgstr ". Там, где клетки разошлись по тону, всё сходится само; там, где они сошлись, окно приходится ставить по замеру."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Тап по карточке ещё раз — снять выбор."
msgstr ". Тап по карточке ещё раз — снять выбор."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Теперь обмер идёт по дереву узлов и складывает трансформы."
msgstr ". Теперь обмер идёт по дереву узлов и складывает трансформы."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Третий набор подряд, который артбуку ничего не стоил: сталь клинка — та же, что у скелетов, дерево древка — то же, что у леса, кожа обмотки — сукно подземелья, синее — краска бочек (§6.1.5)."
msgstr ". Третий набор подряд, который артбуку ничего не стоил: сталь клинка — та же, что у скелетов, дерево древка — то же, что у леса, кожа обмотки — сукно подземелья, синее — краска бочек (§6.1.5)."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Трижды принято за другое: за лысину, за цвет шапки, за кривой силуэт. Причин две: зеркальный вызов при"
msgstr ". Трижды принято за другое: за лысину, за цвет шапки, за кривой силуэт. Причин две: зеркальный вызов при"

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Фонарь — тап по клетке и единица дерева. В замке дорогу не строят: мощение называет маршрут локации — подход, арка ворот, двором к торговцу."
msgstr ". Фонарь — тап по клетке и единица дерева. В замке дорогу не строят: мощение называет маршрут локации — подход, арка ворот, двором к торговцу."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Фонарь против сумки — это «вижу дальше» против «унесу больше», и увидеть это можно только рядом."
msgstr ". Фонарь против сумки — это «вижу дальше» против «унесу больше», и увидеть это можно только рядом."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Цена —"
msgstr ". Цена —"

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Четыре из них — тёплый угол артбука: уголь, жар и пламя рисовались под костёр, солома под кровлю. Их взяли медь и доски: своей меди в палитре нет, а огненный градиент и есть медь. Ещё два набор в артбук"
msgstr ". Четыре из них — тёплый угол артбука: уголь, жар и пламя рисовались под костёр, солома под кровлю. Их взяли медь и доски: своей меди в палитре нет, а огненный градиент и есть медь. Ещё два набор в артбук"

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Четыре из них в артбуке были — огонь достался меди, солома доскам:"
msgstr ". Четыре из них в артбуке были — огонь достался меди, солома доскам:"

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Числа не назначены: вылазка яруса 0 приносит 4,5 камня, улучшение здания до ур. 2 стоит 7 камня и идёт 3 минуты, а первое кольцо — восемь клеток. Требование одно:"
msgstr ". Числа не назначены: вылазка яруса 0 приносит 4,5 камня, улучшение здания до ур. 2 стоит 7 камня и идёт 3 минуты, а первое кольцо — восемь клеток. Требование одно:"

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Число посчитано, а не выбрано, — это весь набор, который вообще может понадобиться врагам:"
msgstr ". Число посчитано, а не выбрано, — это весь набор, который вообще может понадобиться врагам:"

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Чистые алый, синий и жёлтый в палитре не значат ничего — но пока они падали в запасной градиент, они"
msgstr ". Чистые алый, синий и жёлтый в палитре не значат ничего — но пока они падали в запасной градиент, они"

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Что замер отменил, помечено по месту красной чертой; отменены"
msgstr ". Что замер отменил, помечено по месту красной чертой; отменены"

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Шесть ступеней переписаны по градиенту наборов, и это перекрасило заодно стволы леса и деревянные части построек — в этом и смысл единого списка."
msgstr ". Шесть ступеней переписаны по градиенту наборов, и это перекрасило заодно стволы леса и деревянные части построек — в этом и смысл единого списка."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Шкала яркости при этом остаётся"
msgstr ". Шкала яркости при этом остаётся"

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Щит даёт Защиту, при щите обзор не растёт вовсе, и надеть оба нельзя — второй вытесняет первого обратно в рюкзак. Это единственный слот, который игрок пересматривает перед каждым ярусом."
msgstr ". Щит даёт Защиту, при щите обзор не растёт вовсе, и надеть оба нельзя — второй вытесняет первого обратно в рюкзак. Это единственный слот, который игрок пересматривает перед каждым ярусом."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Это главная проверка: если зачистить всё возможно, решения «уйти или идти дальше» не существует, и игра выключается. Одно условие описывает то, ради чего сделано всё остальное."
msgstr ". Это главная проверка: если зачистить всё возможно, решения «уйти или идти дальше» не существует, и игра выключается. Одно условие описывает то, ради чего сделано всё остальное."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Это дисциплинирующее ограничение, а не помеха."
msgstr ". Это дисциплинирующее ограничение, а не помеха."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Это же даёт бесплатную вариативность: одна модель, повёрнутая на 90°, читается как другая постройка."
msgstr ". Это же даёт бесплатную вариативность: одна модель, повёрнутая на 90°, читается как другая постройка."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Это и есть инструмент: стальная голова на деревянной рукояти, а всё остальное — оковка, клёпки и верёвка."
msgstr ". Это и есть инструмент: стальная голова на деревянной рукояти, а всё остальное — оковка, клёпки и верёвка."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Это и есть оружие: у него одна работа и один материал, которым она делается."
msgstr ". Это и есть оружие: у него одна работа и один материал, которым она делается."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Это и есть приёмка: за пределами фонаря цвет пропадает первым, и класс обязан читаться одной чёрной формой. Следопыт — узкий конус капюшона, Ратник — квадратные плечи и щит, Носильщик — горб рюкзака выше головы."
msgstr ". Это и есть приёмка: за пределами фонаря цвет пропадает первым, и класс обязан читаться одной чёрной формой. Следопыт — узкий конус капюшона, Ратник — квадратные плечи и щит, Носильщик — горб рюкзака выше головы."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Это и есть роль «направление» — она работает даже у игрока, который доску никогда не откроет."
msgstr ". Это и есть роль «направление» — она работает даже у игрока, который доску никогда не откроет."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Это и есть цена вопроса, показанная целиком, а не таблицей."
msgstr ". Это и есть цена вопроса, показанная целиком, а не таблицей."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Это не «чуть тяжелее»: это"
msgstr ". Это не «чуть тяжелее»: это"

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Это ответ набора, а не заглушка."
msgstr ". Это ответ набора, а не заглушка."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Это ответ, а не дефект набора — цветов геральдики в палитре нет, потому что геральдики нет в игре."
msgstr ". Это ответ, а не дефект набора — цветов геральдики в палитре нет, потому что геральдики нет в игре."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Это отменяет высокий лес раньше, чем начинается разговор о механике, — и дальше вся конструкция выводится из отмены."
msgstr ". Это отменяет высокий лес раньше, чем начинается разговор о механике, — и дальше вся конструкция выводится из отмены."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Это первое, что замечают на видео, и последнее, что чинят, если не заложить сразу."
msgstr ". Это первое, что замечают на видео, и последнее, что чинят, если не заложить сразу."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Это ровно тот случай, под который §6.1 писал «героев делаем сами»: чужой набор отвечает на вопрос «как это выглядит» и не отвечает на вопрос «кто это»."
msgstr ". Это ровно тот случай, под который §6.1 писал «героев делаем сами»: чужой набор отвечает на вопрос «как это выглядит» и не отвечает на вопрос «кто это»."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Это следующий шаг, и он общий для всех наборов, а не для этого."
msgstr ". Это следующий шаг, и он общий для всех наборов, а не для этого."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Это тот же ответ, что дали знамёна подземелья, —"
msgstr ". Это тот же ответ, что дали знамёна подземелья, —"

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Это читается как «место выдачи», а не «хранилище», и не обещает механики хранения, которой нет."
msgstr ". Это читается как «место выдачи», а не «хранилище», и не обещает механики хранения, которой нет."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ". Эффект, который нельзя прочитать, — это украшение, а украшение в информационном слое стоит дороже, чем весит."
msgstr ". Эффект, который нельзя прочитать, — это украшение, а украшение в информационном слое стоит дороже, чем весит."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid "… из набора едут в игру — по инструменту на занятие жильца: топор у носящего дерево, кирка у носящего камень (RESIDENT_TOOL, §6.1.14). Третий приказ карточки — «отдыхать» — модели не стоит вовсе: отдых и есть пустые руки. Остальные … измерены и лежат: страница — и есть взвешивание."
msgstr "… из набора едут в игру — по инструменту на занятие жильца: топор у носящего дерево, кирка у носящего камень (RESIDENT_TOOL, §6.1.14). Третий приказ карточки — «отдыхать» — модели не стоит вовсе: отдых и есть пустые руки. Остальные … измерены и лежат: страница — и есть взвешивание."


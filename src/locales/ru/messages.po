msgid ": скелет и меш читаются из"
msgstr ": скелет и меш читаются из"

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ": снаряжение в Мастерской, расходники, тренировка героя на Плацу. Экран возврата всегда имеет что предложить — если стройка занята, он предлагает снаряжение."
msgstr ": снаряжение в Мастерской, расходники, тренировка героя на Плацу. Экран возврата всегда имеет что предложить — если стройка занята, он предлагает снаряжение."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ": совпали — сначала урон, отметка сдвигается на 400 мс."
msgstr ": совпали — сначала урон, отметка сдвигается на 400 мс."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ": сталь голов — та же, что у оружия, дерево рукоятей — то же, что у леса, верёвка и кожа — сукно подземелья, медь клёпок — уголь-жар-пламя ресурсов (§6.1.5), латунь — золото оковки, карты и чертежи — краска бочек."
msgstr ": сталь голов — та же, что у оружия, дерево рукоятей — то же, что у леса, верёвка и кожа — сукно подземелья, медь клёпок — уголь-жар-пламя ресурсов (§6.1.5), латунь — золото оковки, карты и чертежи — краска бочек."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ": ступень лестницы §14 берётся здесь из"
msgstr ": ступень лестницы §14 берётся здесь из"

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ": та же сделка «шаги против ран», только цена названа вслух."
msgstr ": та же сделка «шаги против ран», только цена названа вслух."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ": тамошний бот играет в настоящую симуляцию вылазки и нужен для замеров баланса. Первый населяет мир, второй проверяет числа; общего у них только слово."
msgstr ": тамошний бот играет в настоящую симуляцию вылазки и нужен для замеров баланса. Первый населяет мир, второй проверяет числа; общего у них только слово."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ": те же клипы, пересаженные на наш риг Blender'ом ("
msgstr ": те же клипы, пересаженные на наш риг Blender''ом ("

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ": телесный тон нежити был не нужен, а тёплому ненасыщенному негде было встать между деревом и камнем. Сукном красятся и скелеты — одинаковое обязано читаться одинаково."
msgstr ": телесный тон нежити был не нужен, а тёплому ненасыщенному негде было встать между деревом и камнем. Сукном красятся и скелеты — одинаковое обязано читаться одинаково."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ": тот же волновой обход, но с весами (0-K BFS, без кучи)"
msgstr ": тот же волновой обход, но с весами (0-K BFS, без кучи)"

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ": у каждого своя главная семья, и она совпадает с тем, чем он должен читаться."
msgstr ": у каждого своя главная семья, и она совпадает с тем, чем он должен читаться."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ": у каждой вещи есть и прибавка, и цена. Поэтому наведение показывает обе стороны сразу —"
msgstr ": у каждой вещи есть и прибавка, и цена. Поэтому наведение показывает обе стороны сразу —"

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ": у однократной («построй Склад») полосы нет вовсе — полоса 0/1 не сообщает ничего, кроме шума."
msgstr ": у однократной («построй Склад») полосы нет вовсе — полоса 0/1 не сообщает ничего, кроме шума."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ": у одноручного оба набора кладут нуль в одно место с точностью до сотой, у древкового расходятся на семь процентов роста героя. Это и есть ответ, почему в игру взято одноручное."
msgstr ": у одноручного оба набора кладут нуль в одно место с точностью до сотой, у древкового расходятся на семь процентов роста героя. Это и есть ответ, почему в игру взято одноручное."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ": у противника есть раны, замах и откат, и всякий, кто попал бы в список противников локации, вступил бы в бой при сближении. Драться в замке не с кем — он остаётся прогулкой, а не сделкой. Торговли и заданий тоже нет: никто ничего не продаёт и не поручает, и это объявленное состояние, а не забытый шаг."
msgstr ": у противника есть раны, замах и откат, и всякий, кто попал бы в список противников локации, вступил бы в бой при сближении. Драться в замке не с кем — он остаётся прогулкой, а не сделкой. Торговли и заданий тоже нет: никто ничего не продаёт и не поручает, и это объявленное состояние, а не забытый шаг."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ": фигуры собираются из коробок, капсул и эллипсоидов числами, а"
msgstr ": фигуры собираются из коробок, капсул и эллипсоидов числами, а"

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ": ширина ровно в клетку, толщина 0,11–0,30, и стоит она не в клетке, а на границе между двумя."
msgstr ": ширина ровно в клетку, толщина 0,11–0,30, и стоит она не в клетке, а на границе между двумя."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ": это не ошибка измерения, а свойство Vorbis — сведённый в ноль исходник после сжатия выходит за полную шкалу, и такой файл клиппует."
msgstr ": это не ошибка измерения, а свойство Vorbis — сведённый в ноль исходник после сжатия выходит за полную шкалу, и такой файл клиппует."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ": это читается и без цвета вовсе. Шестой канал точки они при этом не занимают — лагерь не узел: в него не ходят, яруса и богатства у него нет, а карточка под картой говорит другое — кто, сколько силы, какой уровень и где он сегодня работает."
msgstr ": это читается и без цвета вовсе. Шестой канал точки они при этом не занимают — лагерь не узел: в него не ходят, яруса и богатства у него нет, а карточка под картой говорит другое — кто, сколько силы, какой уровень и где он сегодня работает."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ": якорь, репер, три стабильных случайных числа и ранг. Геометрия одна — шестигранная призма с сужением и пирамидальной верхушкой, 18 треугольников, — а вариантов столько, сколько чисел. Плотность не пересобирает буферы: инстанс с рангом выше порога получает нулевой масштаб и остаётся в буфере. Поэтому вызовов отрисовки при любом положении ползунка ровно столько же — счётчик под сценой это и показывает."
msgstr ": якорь, репер, три стабильных случайных числа и ранг. Геометрия одна — шестигранная призма с сужением и пирамидальной верхушкой, 18 треугольников, — а вариантов столько, сколько чисел. Плотность не пересобирает буферы: инстанс с рангом выше порога получает нулевой масштаб и остаётся в буфере. Поэтому вызовов отрисовки при любом положении ползунка ровно столько же — счётчик под сценой это и показывает."

#. js-lingui-explicit-id
#: locales/legacy-messages.ts
msgid ": ярусы, богатство и весь счёт карты остаются такими же, какими были до них. Разброс, а не число, — по той же причине, по какой его нет у ярусов: постоянное соотношение делает из карты расписание."
msgstr ": ярусы, богатство и весь счёт карты остаются такими же, какими были до них. Разброс, а не число, — по той же причине, по какой его нет у ярусов: постоянное соотношение делает из карты расписание."


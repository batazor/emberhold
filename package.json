{
  "name": "emberhold",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run check && npm run arch && npm run verify && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "tsx --test \"src/**/*.rules.ts\"",
    "arch": "tsx scripts/arch.ts",
    "verify": "tsx scripts/baseline.ts",
    "baseline": "tsx scripts/baseline.ts --write",
    "measure": "tsx scripts/measure.ts",
    "combat": "tsx scripts/combat.ts",
    "encounter": "tsx scripts/encounter.ts",
    "ammo": "tsx scripts/ammo.ts",
    "hands": "tsx scripts/hands.ts",
    "classes": "tsx scripts/classes.ts",
    "trade": "tsx scripts/trade.ts",
    "fence": "tsx scripts/fence.ts",
    "models": "tsx scripts/models.ts",
    "clips": "tsx scripts/clips.ts",
    "audio": "tsx scripts/audio.ts",
    "play": "tsx scripts/play.ts"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/three": "^0.180.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
